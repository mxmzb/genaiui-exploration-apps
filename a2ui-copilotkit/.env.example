# Copy to .env and set a funded provider key. Do not commit .env.
OPENAI_API_KEY=
MODEL=openai/gpt-5.4
COPILOTKIT_TELEMETRY_DISABLED=true

# Alternatively, use OpenRouter. Keep routing explicit when comparing models.
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# MODEL=openai/gpt-5.4
# OPENROUTER_PROVIDER=azure/eu

# Optional; defaults to ../db/apartments.db, relative to the app working directory.
# APARTMENTS_DB_PATH=../db/apartments.db
