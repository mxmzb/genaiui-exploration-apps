{
  "name": "json-render-copilotkit",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3005",
    "build": "vite build",
    "preview": "vite preview",
    "generate-prompt": "tsx scripts/generate-prompt.ts",
    "typecheck": "tsc --noEmit",
    "agent": "pnpm generate-prompt && cd agent && uv run python server.py",
    "agent:fixture": "pnpm generate-prompt && cd agent && OPENAI_API_KEY=fixture OPENAI_BASE_URL=http://127.0.0.1:9012/v1 uv run uvicorn server:app --host 127.0.0.1 --port 8124",
    "dev:fixture": "AGENT_URL=http://127.0.0.1:8124 vite dev --port 3015 --host 127.0.0.1"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/runtime": "1.83.0",
    "@copilotkit/shared": "1.83.0",
    "@json-render/core": "0.21.4",
    "@json-render/react": "0.21.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "jsonrepair": "3.15.0",
    "nitro": "3.0.261029-rc",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
